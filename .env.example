POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=doc_canvas
POSTGRES_USER=doc_canvas
POSTGRES_PASSWORD=doc_canvas

REDIS_HOST=localhost
REDIS_PORT=6379

RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=doc-canvas
RUSTFS_REGION=us-east-1

FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:8080

# mock | spring-ai
AI_PROVIDER=spring-ai
# 优先使用系统环境变量 GPT_API_KEY；也可写在这里
GPT_API_KEY=
# Spring AI 会拼接 /v1/chat/completions，不要写成 .../v1
GPT_BASE_URL=https://apinebula.ai
OPENAI_API_KEY=
# 按网关可用模型填写，例如 gpt-5.4 / gpt-5.4-mini
AI_MODEL_PLANNER=gpt-5.4
AI_MODEL_EMBEDDING=text-embedding-3-large

# 向量 embedding：阿里百炼 text-embedding-v3（1024 维）
BAILIAN_API_TOKEN=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
